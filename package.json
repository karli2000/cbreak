{
  "name": "coffebreak",
  "type": "module",
  "private": true,
  "scripts": {
    "db:start": "bunx supabase start",
    "db:reset": "bunx supabase db reset",
    "db:test": "bunx supabase db reset && bunx supabase test db",
    "test:int": "bun test tests/integration",
    "test:unit": "bun test tests/unit",
    "test:mod": "claude plugin validate plugin && claude plugin test plugin",
    "dev": "claude --plugin-dir plugin",
    "test:site": "cd site && bun test",
    "site:dev": "cd site && bunx vite",
    "site:build": "cd site && bunx vite build",
    "site:deploy": "bun run site:build && bunx wrangler pages deploy site/dist --project-name coffeebreak-mod"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "supabase": "^3.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
